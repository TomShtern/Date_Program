<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="rootPane" prefHeight="700.0" prefWidth="900.0"
    xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="datingapp.ui.screen.AdminController">
  <top>
    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="header-bar">
      <Button onAction="#handleBack" styleClass="button-transparent">
        <graphic>
          <FontIcon iconLiteral="mdi2c-chevron-left" iconSize="28" iconColor="white"/>
        </graphic>
      </Button>
      <FontIcon iconLiteral="mdi2s-shield-account" iconSize="24" iconColor="#f59e0b"/>
      <Label styleClass="subheading" text="Moderation Admin"/>
    </HBox>
  </top>
  <center>
    <VBox spacing="16">
      <padding>
        <Insets top="28" right="40" bottom="28" left="40"/>
      </padding>
      <HBox alignment="CENTER_LEFT" spacing="12">
        <Button fx:id="refreshButton" onAction="#handleRefresh" styleClass="button-secondary-small" text="Refresh"/>
        <Button fx:id="upholdButton" onAction="#handleUphold" styleClass="button-secondary-small" text="Uphold"/>
        <Button fx:id="dismissButton" onAction="#handleDismiss" styleClass="button-secondary-small" text="Dismiss"/>
        <Button fx:id="banButton" onAction="#handleBan" styleClass="button-danger-small" text="Ban"/>
      </HBox>
      <Label fx:id="statusLabel" styleClass="text-secondary"/>
      <ListView fx:id="pendingReportsListView" prefHeight="420"/>
      <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="8">
        <Label styleClass="text-secondary" text="No pending reviews."/>
      </VBox>
    </VBox>
  </center>
</BorderPane>
