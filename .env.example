# Copy this file to .env for local development.
# Local PostgreSQL is the default runtime path for this repository.
# Docker is an optional fallback only when no local PostgreSQL instance is available.
# Tracked JSON config files intentionally omit databasePassword.
# Supply DATING_APP_DB_PASSWORD via .env, an OS env var, or -Ddatingapp.db.password.
DATING_APP_DB_PROFILE=
# Default local helper scripts use the dev password below.
DATING_APP_DB_PASSWORD=datingapp
DATING_APP_DB_DIALECT=POSTGRESQL
DATING_APP_DB_URL=jdbc:postgresql://localhost:55432/datingapp
DATING_APP_DB_USERNAME=datingapp
DATING_APP_DB_MAX_POOL_SIZE=10
DATING_APP_DB_MIN_IDLE=2
DATING_APP_DB_CONNECTION_TIMEOUT_SECONDS=5
DATING_APP_DB_VALIDATION_TIMEOUT_SECONDS=3
DATING_APP_DB_IDLE_TIMEOUT_SECONDS=600
DATING_APP_DB_MAX_LIFETIME_SECONDS=1800
# TCP keepalive for idle pool connections. 0 = disabled (local dev only).
# In production, set to 30-60 to prevent firewall/load-balancer idle-connection drops.
DATING_APP_DB_KEEPALIVE_TIME_SECONDS=0

# Auth: Clerk session tokens
# The REST server verifies Clerk session JWTs against Clerk's public keys, so no Clerk secret key is needed here.
# Required for the REST server (the CLI and desktop app do not use it). Use your instance's Frontend API URL,
# for example https://your-instance.clerk.accounts.dev. It is public, not a secret.
# Find it in the Clerk dashboard under Domains, or see "Finding your Clerk issuer" in docs/guides/lan-backend-startup.md.
DATING_APP_AUTH_CLERK_ISSUER=
# Optional. Defaults to <issuer>/.well-known/jwks.json
# DATING_APP_AUTH_CLERK_JWKS_URL=
# Optional, comma-separated origins allowed in the token's azp claim. Tokens without azp are accepted.
# DATING_APP_AUTH_CLERK_AUTHORIZED_PARTIES=
# Optional clock skew tolerance for exp/nbf checks, in seconds (default 5).
# DATING_APP_AUTH_CLOCK_SKEW_SECONDS=5

# REST API LAN mode (phone-alpha testing)
# Non-loopback binding requires a shared secret. It is NOT read from this file: the REST server reads
# DATING_APP_REST_SHARED_SECRET from the process environment only (System.getenv), and
# scripts/start_phone_alpha_backend.ps1 falls back to %LOCALAPPDATA%\DateProgram\rest-shared-secret.txt.
# Create that file once with scripts/new_rest_shared_secret.ps1; never put the value here or in git.
# Optional CORS allowlist for Flutter web or browser-based clients.
# Example: DATING_APP_REST_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.100:3000
