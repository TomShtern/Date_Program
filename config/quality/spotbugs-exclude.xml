<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        Narrow, justified suppressions only. Every entry names the exact class/method and the reason:
        either a verified false positive or an explicitly accepted, documented trade-off.
        Real bugs are fixed in code instead — see Snapshots, SqlRowReaders.readRequired*,
        PhotoStore.PhotoContent copy-in/copy-out.
    -->

    <!-- Fail-fast constructor validation. These constructors only call Objects.requireNonNull,
         field assignments, and argument checks — never overridable methods — so the subclassing
         hazard behind CT_CONSTRUCTOR_THROW does not apply. -->
    <Match>
        <Class name="datingapp.app.usecase.profile.VerificationUseCases" />
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
    </Match>
    <Match>
        <Class name="datingapp.core.model.Match" />
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
    </Match>
    <Match>
        <Class name="datingapp.core.metrics.SwipeState$Session" />
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
    </Match>

    <!-- SQL text blocks. '\n' is intentional: SQL sent to the database must be byte-identical on
         every platform so schema snapshots and migration checksums stay deterministic. '%n' would
         make DDL platform-dependent. -->
    <Match>
        <Class name="datingapp.storage.jdbi.JdbiMetricsStorage" />
        <Method name="buildSessionAggregatesSql" />
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE" />
    </Match>
    <Match>
        <Class name="datingapp.storage.schema.SchemaInitializer" />
        <Method name="createMatchesTable" />
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE" />
    </Match>
    <Match>
        <Class name="datingapp.storage.schema.SchemaInitializer" />
        <Method name="createMessagingSchema" />
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE" />
    </Match>
    <Match>
        <Class name="datingapp.storage.schema.SchemaInitializer" />
        <Method name="createSocialSchema" />
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE" />
    </Match>
    <Match>
        <Class name="datingapp.storage.schema.SchemaInitializer" />
        <Method name="createUndoStateSchema" />
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE" />
    </Match>

    <!-- JavaFX binding idiom. Exposing *Property() and ObservableList getters is required for
         FXML/controller binding; the lists are populated exclusively on the FX thread via
         ViewModelAsyncScope. -->
    <Match>
        <Package name="datingapp.ui.viewmodel" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,EI_EXPOSE_STATIC_REP2" />
    </Match>
    <Match>
        <Package name="datingapp.ui.screen" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Package name="datingapp.ui" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,EI_EXPOSE_STATIC_REP2" />
    </Match>

    <!-- CLI wiring. Handlers are constructed once by the menu registry with collaborator
         references; they never leak them further. -->
    <Match>
        <Package name="datingapp.app.cli" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>

    <!-- Dependency-injection holders. Storing/returning collaborator references is the composition
         pattern; all holders are wired once at startup and never reconfigured concurrently. -->
    <Match>
        <Class name="~.*\$Dependencies" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="~.*\$Builder" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.core.ServiceRegistry" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.core.metrics.AchievementService" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.profile.ProfileMutationUseCases" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.storage.jdbi.JdbiMatchmakingStorage" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.profile.ProfileUseCases" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.app.api.RestApiServer" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <!-- Singletons. getInstance() returning the singleton is the pattern itself. -->
    <Match>
        <Class name="datingapp.core.AppSession" />
        <Bug pattern="MS_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.storage.DatabaseManager" />
        <Bug pattern="MS_EXPOSE_REP" />
    </Match>

    <!-- Immutable-value false positives. Instant is immutable; AuthConfig/ModerationAuditEvent
         already normalize their collections to immutable copies in their compact constructors. -->
    <Match>
        <Class name="datingapp.app.bootstrap.CleanupScheduler$CleanupStatus" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.core.AppConfig$AuthConfig" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.core.matching.ModerationAuditEvent" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <!-- Shared mutable domain entities. User/Conversation/Match are passed by reference across
         use-case boundaries by architectural design (identity + in-place session updates);
         User.copy()/Conversation.copyOf() are used at persistence trust boundaries instead.
         Accepted trade-off, documented here rather than redesigning entity identity. -->
    <Match>
        <Class name="datingapp.app.usecase.matching.MatchingUseCases$BrowseCandidatesCommand" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.matching.MatchingUseCases$ProcessSwipeCommand" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.matching.MatchingUseCases$StandoutsQuery" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.profile.ProfileMutationUseCases$SavePhotoUrlsCommand" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.profile.ProfileMutationUseCases$SaveProfileCommand" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.profile.ProfileMutationUseCases$CreateUserResult" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.profile.ProfileMutationUseCases$ProfileSaveResult" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.profile.VerificationUseCases$ConfirmVerificationResult" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.profile.VerificationUseCases$StartVerificationResult" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.core.connection.ConnectionService$ConversationPreview" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.messaging.MessagingUseCases$OpenConversationResult" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.core.matching.DailyPickService$DailyPick" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.core.matching.MatchingService$PendingLiker" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.core.profile.ProfileService$ProfilePreview" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="datingapp.core.workflow.ProfileActivationPolicy$ActivationResult" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>

    <!-- Builder ownership transfer. StorageBuilder.build() hands the freshly built User to the
         caller; builders are single-use chains, never shared after build. -->
    <Match>
        <Class name="datingapp.core.model.User$StorageBuilder" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <!-- Snapshot-backed record accessors. Each listed record snapshots every collection component
         into a private unmodifiable copy in its compact constructor (see Snapshots), so the
         accessor cannot expose anything the caller could mutate. SpotBugs flags these on declared
         type alone and cannot see the copy; the residual EI_EXPOSE_REP is a tool limitation. -->
    <Match>
        <Class name="datingapp.app.usecase.matching.MatchingUseCases$ActiveMatchesResult" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.matching.MatchingUseCases$BrowseCandidatesResult" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.matching.MatchingUseCases$PagedMatchesResult" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.matching.MatchingUseCases$StandoutsResult" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.messaging.MessagingUseCases$ConversationListResult" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.messaging.MessagingUseCases$ConversationThread" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.messaging.MessagingUseCases$CountMessagesByConversationIdsQuery" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.profile.ProfileMutationUseCases$UpdateProfileCommand" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.profile.ProfileMutationUseCases$UpdateDiscoveryPreferencesCommand" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.app.usecase.profile.ProfileUseCases$GetUsersByIdsQuery" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.core.connection.ConnectionService$MessageLoadResult" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.core.matching.StandoutService$Result" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="datingapp.storage.DevDataSeeder$SeedUserDefinition" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
</FindBugsFilter>
